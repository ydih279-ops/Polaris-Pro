# Copy to .env for local dev. On Render these come from the dashboard / blueprint.
DATABASE_URL=postgres://polaris:polaris@localhost:5432/polaris
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
PORT=5000
PUBLIC_URL=http://localhost:5000

# Optional — without these, alert/report emails are logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Polaris <alerts@polaris.app>
